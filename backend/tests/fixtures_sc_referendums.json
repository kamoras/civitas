 "detail_691": "<html><body><main class=\"content\">\n    <div class=\"grid-container\">\n        <div class=\"grid-x grid-margin-x\">\n            <div class=\"cell\">\n                <h1>Referendum Detail</h1>\n                \n<div class=\"fluid\" id=\"candidateDetailContainer\">\n    <form id=\"detailForm\">\n        <input type=\"hidden\" data-val=\"true\" data-val-required=\"The ReferendumID field is required.\" id=\"ReferendumID\" name=\"ReferendumID\" value=\"691\" />\n        <input type=\"hidden\" id=\"ElectionID\" name=\"ElectionID\" value=\"22114\" />\n        <div class=\"text-left pb-3\">\n                <a href='/Candidate/ReferendumSearch?electionId=22114' class=\"styled-button styled-fixed-width grid-x\" onclick=\"iForms.ShowOpeningPageMessage(true)\">\n                    <span class=\"material-icons-outlined\">arrow_back</span>\n                    <text>Back to Search</text>\n                </a>\n\n        </div>\n        <div class=\"grid-y large-12\">\n            <div>\n                <h2 class=\"font-bold\">Constitutional Amendment Question</h2>\n            </div>\n            <div class=\"cell large-6 iforms-inline\">\n                <div class=\"cell pt-0 grid-x\">\n                    <span class=\"label-min-width font-bold\">Election</span>\n                    <span class=\"text-min-width\">Statewide General Election</span>\n                </div>\n                <div class=\"cell pt-0 grid-x\">\n                    <span class=\"label-min-width font-bold\">Election Date</span>\n                    <span class=\"text-min-width\">\n11/5/2024                    </span>\n                </div>\n                <div class=\"cell pt-0 grid-x\">\n                    <span class=\"label-min-width font-bold\">Responsible County</span>\n                    <span class=\"text-min-width\"></span>\n                </div>\n                <div class=\"cell pt-0 grid-x\">\n                    <span class=\"label-min-width font-bold\">District Type</span>\n                    <span class=\"text-min-width\"></span>\n                </div>\n                <div class=\"cell pt-0 grid-x\">\n                    <span class=\"label-min-width font-bold\">District</span>\n                    <span class=\"text-min-width\"></span>\n                </div>\n                <div class=\"cell pt-0 grid-x\">\n                    <span class=\"label-min-width font-bold\">Referendum Type</span>\n                    <span class=\"text-min-width\">Statewide Constitutional Amendments</span>\n                </div>\n                <div class=\"cell pt-2 grid-x\">\n                    <span class=\"label-min-width font-bold\">Referendum Text</span>\n                    <div style=\"max-width: 600px\">\n                        Must Section 4, Article II of the Constitution of this State, relating to voter qualifications, be amended so as to provide that only a citizen of the United States and of this State of the age of eighteen and upwards who is properly registered is entitled to vote as provided by law?\n                    </div>\n                </div>\n                <div class=\"cell pt-2 grid-x\">\n                    <span class=\"label-min-width font-bold\">Responses</span>\n                    <div class=\"grid-y\">\n                        <span class=\"text-min-width\">Yes, In Favor of the Question</span>\n                        <span class=\"text-min-width\">No, Opposed to the Question</span>\n                        <span class=\"text-min-width\"></span>\n                        <span class=\"text-min-width\"></span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </form>\n</div>\n\n\n            </div>\n        </div>\n    </div>\n</main></body></html>"
