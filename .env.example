# ─── Required ──────────────────────────────────────────────────
# Government data API key (covers Congress.gov, FEC, GovInfo, and Regulations.gov).
# Sign up free at https://api.data.gov/signup/
DATA_GOV_API_KEY=your-api-data-gov-key

# ─── Optional: statewide ballot measures ─────────────────────
# Vote Smart API key — powers the statewide ballot-measure digest on
# /elections/states/<ST>. Free key at https://votesmart.org/share/api
# Leave blank to run without it: the measure sync is skipped and every
# state page says so explicitly and links the state's own official
# ballot lookup instead. It never renders as "no measures on the ballot".
VOTESMART_API_KEY=

# ─── Optional: town-level ballot lookup ───────────────────────
# Google Civic Information API key (voterInfoQuery) — powers a small,
# hand-curated set of town-level ballot lookups on /elections/states/<ST>
# (city council, school board, local measures). Free key at
# https://console.cloud.google.com/apis/library/civicinfo.googleapis.com
# Never called with a visitor's own address — only a fixed, publicly-known
# representative address per town (app/data/town_directory.json), so no
# visitor data leaves the server. Leave blank to run without it: the town
# selector simply doesn't appear, and the statewide page is unaffected.
GOOGLE_CIVIC_API_KEY=

# ─── LLM Backend ─────────────────────────────────────────────
# "llama-server" = native llama.cpp server (fastest on ARM/RPi)
# "ollama"       = Ollama Docker service (simpler setup, slower on ARM)
LLM_BACKEND=llama-server

# Native llama-server URL (used when LLM_BACKEND=llama-server).
# Runs as a systemd service on the host; Docker reaches it via host.docker.internal.
LLAMA_SERVER_URL=http://host.docker.internal:8070

# Ollama fallback URL (used when LLM_BACKEND=ollama). Ollama isn't bundled
# in docker-compose.yml — point this at your own ollama instance (e.g. a
# host-level install reachable via http://host.docker.internal:11434, or
# a separate compose service you add yourself).
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Model name (used for cache key differentiation and Ollama model selection).
OLLAMA_MODEL=LiquidAI/lfm2.5-1.2b-instruct

# Optional larger model used only for narrative/story generation, leaving
# OLLAMA_MODEL to handle everything else. Unset = use OLLAMA_MODEL for all
# calls (the default). Requires pulling the model in Ollama first, e.g.
# OLLAMA_STORY_MODEL=qwen3:4b — a dense 4B at Q4 (~3GB) fits the Pi's
# measured headroom; 30B-class MoE models do not.
#
# ONLY TAKES EFFECT WHEN LLM_BACKEND=ollama. The llama-server path ignores
# it: _call_llama_server() sends no model field, because llama-server
# serves the single model it was launched with. Under the default backend
# this setting still changes the LLM cache key, so setting it forces a
# round of regeneration that can look like it took effect while every
# response still comes from OLLAMA_MODEL. Note also that docker-compose.yml
# pins LLM_BACKEND=llama-server in the backend service's `environment:`
# block, which overrides this file — switching backends means editing the
# compose file, not just .env.
OLLAMA_STORY_MODEL=

# ─── Pipeline ─────────────────────────────────────────────────
# How long to cache API responses before re-fetching (hours).
PIPELINE_CACHE_TTL_HOURS=72

# Logging: debug | info | warning | error
PIPELINE_LOG_LEVEL=info

# Cron expression for automatic pipeline runs (default: 3 AM daily).
PIPELINE_CRON_SCHEDULE=0 3 * * *

# Bearer token for the POST /api/pipeline/run endpoint.
# Generate something random: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PIPELINE_TRIGGER_TOKEN=change-me-to-a-random-token

# Token for the /admin management panel.
# If not set, falls back to PIPELINE_TRIGGER_TOKEN.
ADMIN_TOKEN=change-me-to-a-random-token

# Comma-separated list of origins allowed to call the API from a browser
# (e.g. https://civitas-research.org). Leave empty in production only if
# the frontend and backend share an origin behind the same reverse proxy.
CORS_ORIGINS=

# Congress the pipeline treats as "current" for vote/bill/effectiveness
# windowing — see AGENTS.md "current term". Bump once per new Congress.
CURRENT_CONGRESS=119

# Per-source rate limits (requests/second) — tune down if a fetcher starts
# getting 429s, tune up only after confirming the source's documented limit.
CONGRESS_RPS=1.2
FEC_RPS=0.25
GOVINFO_RPS=1.0
HOUSE_PTR_RPS=1.0
SENATE_PTR_RPS=0.5

# Hours a pipeline run can exceed its normal duration before an operator
# alert fires (app/ops_alerts.py).
PIPELINE_OVERRUN_ALERT_HOURS=8.0

# ─── Database ─────────────────────────────────────────────────
# SQLite path inside the container. The /data volume is persisted
# by docker compose so data survives container restarts.
DATABASE_URL=sqlite:////data/civitas.db

# ─── Bluesky integration (optional) ──────────────────────────
# When set, the action center will post new issues and surge alerts to Bluesky.
# Create an App Password at bsky.app → Settings → Privacy and Security → App Passwords.
# Leave BSKY_HANDLE empty to disable entirely.
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# ─── Site feedback form (optional) ───────────────────────
# When set, /feedback submissions are filed as GitHub issues (labeled
# "user-feedback") on GITHUB_FEEDBACK_REPO. Create a fine-grained PAT at
# github.com/settings/tokens?type=beta scoped to ONLY this repo, with
# Issues: Read and write permission — not a classic token with full repo
# scope. Leave empty to disable; the endpoint returns 503 rather than
# silently dropping submissions.
FEEDBACK_TOKEN=
GITHUB_FEEDBACK_REPO=kamoras/civitas

# ─── Operator alerts (optional) ──────────────────────────
# Pipeline-failure/overrun notifications (app/ops_alerts.py) — pushed via
# ntfy.sh if set. Leave empty to disable; alerts are always logged and
# recorded for the admin dashboard regardless.
ALERT_NTFY_URL=
