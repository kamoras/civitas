# ─── Required ──────────────────────────────────────────────────
# Government data API key (covers Congress.gov, FEC, GovInfo, and Regulations.gov).
# Sign up free at https://api.data.gov/signup/
DATA_GOV_API_KEY=your-api-data-gov-key

# Your instance's contact address: named in the User-Agent of every request
# the pipeline and the maintenance scripts send, so a source can tell who is
# fetching and reach you about the traffic (backend/app/contact.py). Use an
# address you read. The SEC's fair-access policy requires one: unset (or not
# an email address), requests name Civitas with no contact, SEC fetches are
# refused with an ops alert (trade and PAC-sponsor industries stop
# refreshing), and the pipeline logs a warning at start.
CONTACT_EMAIL=

# ─── Your site's address and the proxy in front of it ────────
# The public address every link, feed, share card, canonical tag and
# robots.txt names. Unset = the production site (https://civitas-research.org);
# a self-hosted copy under its own domain sets it, no trailing slash. Read by
# the backend at start and baked into the frontend at build
# (docker-compose.yml passes it as NEXT_PUBLIC_SITE_URL), so rebuild the
# frontend after changing it. See docs/self-hosting.md.
# SITE_URL=https://civic.example.org

# Which proxy in front of nginx may tell it the visitor's address
# (nginx/real-ip.sh, Swarm only). Unset = loopback only. Behind a reverse
# proxy, set it to that proxy's address as nginx sees it (production: the
# Pi's LAN address, where its host nginx connects from); space-separated
# addresses or CIDRs. Missing or wrong, and every visitor counts as one
# address. "none" trusts no one.
# REAL_IP_FROM=192.168.1.10
# REAL_IP_HEADER=X-Real-IP

# ─── Optional: Bureau of Labor Statistics ─────────────────────
# Free v2 registration key (https://data.bls.gov/registrationEngine/): lifts
# the BLS API's 25 requests a day without a key to 500. Jobs data for the
# president scores works without it.
# BLS_API_KEY=

# ─── Optional: town-level ballot lookup ───────────────────────
# Google Civic Information API key (voterInfoQuery) — powers a small,
# hand-curated set of town-level ballot lookups on /elections/states/<ST>
# (city council, school board, local measures). Free key at
# https://console.cloud.google.com/apis/library/civicinfo.googleapis.com
# Never called with a visitor's own address — only a fixed, publicly-known
# representative address per town (app/data/town_directory.json), so no
# visitor data leaves the server. Leave blank to run without it: the town
# selector simply doesn't appear, and the statewide page is unaffected.
GOOGLE_CIVIC_API_KEY=

# ─── LLM Backend ─────────────────────────────────────────────
# "llama-server" = native llama.cpp server (fastest on ARM/RPi)
# "ollama"       = Ollama Docker service (simpler setup, slower on ARM)
LLM_BACKEND=llama-server

# llama-server URL (used when LLM_BACKEND=llama-server). "llama-server" is
# the service's DNS name on the compose/overlay network -- it runs in
# docker-compose.yml via the official ghcr.io/ggml-org/llama.cpp:server
# image, not a host-level install.
LLAMA_SERVER_URL=http://llama-server:8070

# Host directory holding the .gguf model file(s), bind-mounted read-only
# into the llama-server container at /models. See README's LLM Backend
# Options for how to obtain the model.
LLAMA_MODELS_DIR=./llama-models

# Filename (inside LLAMA_MODELS_DIR) llama-server loads.
LLAMA_MODEL_FILE=lfm2.5-1.2b-instruct-q4_k_m.gguf

# Ollama fallback URL (used when LLM_BACKEND=ollama). Ollama isn't bundled
# in docker-compose.yml — point this at your own ollama instance (e.g. a
# host-level install reachable via http://host.docker.internal:11434, or
# a separate compose service you add yourself).
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Model name (used for cache key differentiation and Ollama model selection).
OLLAMA_MODEL=LiquidAI/lfm2.5-1.2b-instruct

# Optional larger model used only for narrative/story generation, leaving
# OLLAMA_MODEL to handle everything else. Unset = use OLLAMA_MODEL for all
# calls (the default). Requires pulling the model in Ollama first, e.g.
# OLLAMA_STORY_MODEL=qwen3:4b — a dense 4B at Q4 (~3GB) fits the Pi's
# measured headroom; 30B-class MoE models do not.
#
# ONLY TAKES EFFECT WHEN LLM_BACKEND=ollama. The llama-server path ignores
# it: _call_llama_server() sends no model field, because llama-server
# serves the single model it was launched with. Under the default backend
# this setting still changes the LLM cache key, so setting it forces a
# round of regeneration that can look like it took effect while every
# response still comes from OLLAMA_MODEL. Note also that docker-compose.yml
# pins LLM_BACKEND=llama-server in the backend service's `environment:`
# block, which overrides this file — switching backends means editing the
# compose file, not just .env.
OLLAMA_STORY_MODEL=

# ─── Pipeline ─────────────────────────────────────────────────
# How long to cache API responses before re-fetching (hours).
PIPELINE_CACHE_TTL_HOURS=72

# Logging: debug | info | warning | error
PIPELINE_LOG_LEVEL=info

# Cron expression for automatic pipeline runs (default: 3 AM daily).
PIPELINE_CRON_SCHEDULE=0 3 * * *
# Which half of the backend this process runs: all (default — API and
# pipeline in one process, for local use), api (read-only), or worker
# (scheduler + pipelines). Production sets it per service in
# docker-compose.swarm.yml; leave it unset here.
# PROCESS_ROLE=all

# Bearer token for the public POST /api/pipeline/trigger routes.
# Generate something random: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The placeholder below (for this and ADMIN_TOKEN) is public, so the server
# treats it as unset and refuses it (app/api/auth.py): replace both.
PIPELINE_TRIGGER_TOKEN=change-me-to-a-random-token

# Token for the /admin management panel.
# If not set, falls back to PIPELINE_TRIGGER_TOKEN.
ADMIN_TOKEN=change-me-to-a-random-token

# Comma-separated list of origins allowed to call the API from a browser
# (e.g. https://civitas-research.org). Leave empty in production only if
# the frontend and backend share an origin behind the same reverse proxy.
CORS_ORIGINS=

# Congress the pipeline treats as "current" for vote/bill/effectiveness
# windowing and for House members' district lines — see AGENTS.md "current
# term". LEAVE UNSET: it follows the clock, so it never needs a bump — the
# Congress in office (noon ET on Jan 3 of an odd year starts the next one)
# at process start, advanced at the start of each pipeline job, which holds
# it for the whole job (config.scoring_congress). The scored windows and the
# district lines are the one value: they move together, with no restart, at
# the first House run in a job that starts after that noon (with the default
# 03:00 UTC schedule, the nightly chain that starts that evening). Any value
# set here is an operator PIN that freezes both — the scored windows and the
# district lines — on that Congress, past the next Jan 3, until removed; ops_alerts.check_current_congress_staleness alerts once a pin
# falls behind. Set it only to re-run the pipeline against an archived
# database from an earlier Congress; never in production. A deployment whose
# .env still says 119 should delete the line.
# CURRENT_CONGRESS=119

# Per-source rate limits (requests/second) — tune down if a fetcher starts
# getting 429s, tune up only after confirming the source's documented limit.
CONGRESS_RPS=1.2
FEC_RPS=0.25
# Optional: free Lobbying Disclosure Act API key (register at https://lda.gov/api/register/).
# Raises the registry's ~15 requests/minute anonymous limit, which bounds the
# nightly donor-vote lobbying lookups. Leave empty to run anonymously.
LDA_API_KEY=
GOVINFO_RPS=1.0
HOUSE_PTR_RPS=1.0
SENATE_PTR_RPS=0.5
PRESIDENT_PTR_RPS=0.5

# Hours a pipeline run can exceed its normal duration before an operator
# alert fires (app/ops_alerts.py::check_pipeline_overrun).
PIPELINE_OVERRUN_ALERT_HOURS=8.0

# Days a nightly pipeline may go with no SUCCESSFUL completion before it
# is reported stale (app/ops_alerts.py::check_pipeline_staleness). The
# complement to the overrun alert above: that one catches a run taking
# too long, this one catches a run that never happened at all — the case
# that let the 2026-09 outage run 19 nights unnoticed, since a pipeline
# that never starts has no row for the overrun check to find. Two days,
# not one, so a single missed night (which self-heals) stays quiet.
PIPELINE_STALE_ALERT_DAYS=2.0

# ─── Database ─────────────────────────────────────────────────
# SQLite path inside the container. The /data volume is persisted
# by docker compose so data survives container restarts.
DATABASE_URL=sqlite:////data/civitas.db

# ─── Bluesky integration (optional) ──────────────────────────
# When set, every post Civitas publishes (issues, Congress days and weeks, the
# member spotlight, race updates) is also sent to Bluesky. Posts go to the Atom
# feeds (/feed.xml, /feeds) either way; these only add Bluesky.
# Create an App Password at bsky.app → Settings → Privacy and Security → App Passwords.
# Leave BSKY_HANDLE empty to publish to the feeds only.
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# ─── Site feedback form (optional) ───────────────────────
# When set, /feedback submissions are filed as GitHub issues (labeled
# "user-feedback") on GITHUB_FEEDBACK_REPO. Create a fine-grained PAT at
# github.com/settings/tokens?type=beta scoped to ONLY this repo, with
# Issues: Read and write permission — not a classic token with full repo
# scope. Leave empty to disable; the endpoint returns 503 rather than
# silently dropping submissions.
FEEDBACK_TOKEN=
GITHUB_FEEDBACK_REPO=kamoras/civitas

# ─── Operator alerts (optional) ──────────────────────────
# Pipeline-failure/overrun notifications (app/ops_alerts.py) — pushed via
# ntfy.sh if set. Leave empty to disable; alerts are always logged and
# recorded for the admin dashboard regardless.
ALERT_NTFY_URL=
