{
  "ci": {
    "collect": {
      "startServerCommand": "npm start",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 60000,
      "numberOfRuns": 1,
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/about",
        "http://localhost:3000/accessibility",
        "http://localhost:3000/politicians",
        "http://localhost:3000/bills",
        "http://localhost:3000/leaderboard",
        "http://localhost:3000/action",
        "http://localhost:3000/search?tab=documents",
        "http://localhost:3000/search?q=tariffs",
        "http://localhost:3000/compare",
        "http://localhost:3000/changelog",
        "http://localhost:3000/feeds",
        "http://localhost:3000/developers"
      ],
      "settings": {
        "onlyCategories": [
          "accessibility",
          "seo"
        ],
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/search\\?q=).*$",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/search\\?q=.*",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "is-crawlable": "off",
            "document-title": "error",
            "meta-description": "error",
            "http-status-code": "error",
            "link-text": "error",
            "crawlable-anchors": "error",
            "hreflang": "error",
            "canonical": "error",
            "image-alt": "error"
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
