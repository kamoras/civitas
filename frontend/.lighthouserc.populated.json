{
  "ci": {
    "collect": {
      "startServerCommand": "npm start",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 60000,
      "numberOfRuns": 1,
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/leaderboard",
        "http://localhost:3000/politicians",
        "http://localhost:3000/politicians/S000",
        "http://localhost:3000/politicians/R-CT1",
        "http://localhost:3000/compare",
        "http://localhost:3000/explore",
        "http://localhost:3000/explore/1",
        "http://localhost:3000/action",
        "http://localhost:3000/elections",
        "http://localhost:3000/elections/states/CT",
        "http://localhost:3000/feeds"
      ],
      "settings": {
        "onlyCategories": ["accessibility", "seo"],
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-populated"
    }
  }
}
