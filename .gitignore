*.tsbuildinfo
next-env.d.ts

# editor
.vscode/
.idea/
*.swp
*.swo
*~

# docker volume mount
/data/
backend/.cache/

# Claude Code local settings (session data, worktrees)
.claude/settings.local.json

# deploy state
.deploy-*-slot

# database files (never commit data to the repo)
backend/*.db
# runtime state the app writes when it runs outside Docker: the dev
# database, and the two directories the election feature keeps its
# discovered sources and read-back election dates in. All of it is
# regenerated on the next run and none of it belongs in git.
backend/data/

# python
*.egg-info/
.venv/
venv/
.claude/worktrees/

# host-specific ops scripts (not part of the shipped project)
/backup.sh

# pull-based deploy log (check-and-deploy.sh)
/deploy-poll.log
/.last-deployed-sha

# local .gguf model file(s) for the llama-server Docker service
# (LLAMA_MODELS_DIR default) — large binaries, operator-provided
/llama-models/

# defense-in-depth: never commit these even if something creates them
*.key
*.sqlite
credentials.json

# coverage outputs (backend CI gate; see ci.yml)
.coverage
htmlcov/
coverage.xml
diff_coverage.md
