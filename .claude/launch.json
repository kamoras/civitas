{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--port",
        "8001",
        "--app-dir",
        "backend"
      ],
      "port": 8001,
      "env": {
        "DATABASE_URL": "sqlite:////tmp/claude-1000/civitas-local/civitas.db"
      }
    }
  ]
}
